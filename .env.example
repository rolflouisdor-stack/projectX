# Gravitas Leads — Mailer Portal (detached service)
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-32-byte-hex
PORT=5070

# ─── The one-knob host config ─────────────────────────────────────────────
# THIS is the only value that changes when you deploy. Everything that needs
# an absolute URL (Stripe webhooks, CORS, anything that has to know "where am
# I really hosted") reads from PUBLIC_BASE_URL. On DigitalOcean App Platform
# set it to the app URL (e.g. https://mailer-xyz.ondigitalocean.app) or your
# custom domain (https://mailer.gravitasleads.com).
PUBLIC_BASE_URL=http://127.0.0.1:5070

# Browser origins allowed to call /api/* cross-origin. Comma-separated.
# Same-origin (mailer's templates → mailer's API) doesn't need an entry.
# Once the CX3 Dashboard has its public origin, list it here.
CORS_ORIGINS=

# MySQL — own database, separate from cx3_dashboard.
# DigitalOcean Managed MySQL: DATABASE_URL env var is auto-injected if you
# attach the DB to this App component — same format as below.
DATABASE_URL=mysql+pymysql://root:Newpassword12%40@localhost/gravitas_mailer

# JWT cookie auth
JWT_TOKEN_EXPIRY_SECONDS=86400
JWT_COOKIE_SECURE=false

# Internal cross-system API — the key CX3 Dashboard sends in X-Internal-Api-Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=replace-me-with-a-32-byte-hex-string

# Stubbed third-party integrations (all toggle to true once real keys are in place)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_VALIDATOR_ENABLED=false
EMAIL_VALIDATOR_PROVIDER=neverbounce
EMAIL_VALIDATOR_API_KEY=

# Where generated Excel files live (signed download URLs point here in prod)
ARTIFACT_DIR=/tmp/gravitas_mailer_artifacts
ARTIFACT_TTL_DAYS=30

# ─── Object storage (DigitalOcean Spaces — S3-compatible) ────────────────
# All uploaded scrub lists and generated result xlsx files live here.
# Local dev can point at any S3-compatible endpoint (minio, AWS S3, Spaces).
# Create a Spaces bucket at https://cloud.digitalocean.com/spaces (one per
# environment: gravitas-mailer-dev, gravitas-mailer-prod). Generate an
# access key under Spaces → "Access Keys". Keep these out of git.
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=gravitas-mailer-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Size of each presigned multipart upload part. AWS minimum is 5 MiB.
S3_MULTIPART_PART_SIZE_BYTES=10485760
# Presigned URL lifetimes (seconds).
S3_UPLOAD_URL_TTL=600
S3_DOWNLOAD_URL_TTL=3600

# ─── Background job queue (RQ + Redis) ────────────────────────────────────
# Required for the file-import worker — parsing 100+ MB CSV/XLSX inline
# would block gunicorn workers and exceed App Platform's HTTP timeouts.
# Local dev: brew install redis && brew services start redis
# Production: attach a DigitalOcean Managed Redis to the app.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=mailer-default

# Transactional email — job notifications (scrub ready / file ready / failed).
# Provider-agnostic SMTP: works with SendGrid, Postmark, Resend, Mailgun, etc.
# Off until you set creds + verify the sender domain (SPF/DKIM). Then set
# EMAIL_ENABLED=true and fill SMTP_* with your provider's SMTP relay creds.
EMAIL_ENABLED=false
SMTP_HOST=                       # e.g. smtp.sendgrid.net / smtp.postmarkapp.com / smtp.resend.com
SMTP_PORT=587
SMTP_USER=                       # provider username (often "apikey" for SendGrid)
SMTP_PASSWORD=                   # provider API key / SMTP password (SECRET)
SMTP_USE_TLS=true
EMAIL_FROM=Gravitas Leads <noreply@gravitasleads.io>   # must be on a verified domain
